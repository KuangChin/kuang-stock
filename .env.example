# Claude 分析師（可選；沒有就只跑規則引擎）
ANTHROPIC_API_KEY=
# 金鑰未綁定工作區時才需要
# ANTHROPIC_WORKSPACE_ID=

# 頁面與 API 密碼（設定後所有頁面與 API 都要登入；本機不設就不用登入）
# 本機 npm run advisors-push 把投顧 YouTube 字幕推上雲端時用（與 GitHub Actions 的設定相同）
APP_URL=https://kuang-stock.vercel.app
APP_PASSWORD=
# 排程呼叫 POST /api/cycle 用的密鑰（GitHub Actions secret 要填同一個值），建議：openssl rand -hex 32
CRON_SECRET=

# Upstash Redis（Vercel Marketplace 建立後會自動注入；本機要匯入狀態時才需要填）
# 沒有這兩個變數時，狀態與快取存本機 data/ 目錄
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
